; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CodeQuest - La Recherche des livres oubliés"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/CDP-2026"
run/main_scene="res://scenes/ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/output_latency.web=200

[autoload]

Api="*res://scripts/api.gd"
GameState="*res://scripts/game_state.gd"
Display="*res://scripts/display.gd"
Account="*res://scripts/account.gd"
PauseMenu="*res://scripts/pause_menu.gd"
Hints="*res://scripts/hints.gd"
Transition="*res://scripts/transition.gd"
GameSync="*res://scripts/game_sync.gd"
DebugMenu="*res://scenes/debug/debug_menu.tscn"
Music="*res://scripts/music.gd"
RenderQuality="*res://scripts/render_quality.gd"

[cdp]

api/base_url=""

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"


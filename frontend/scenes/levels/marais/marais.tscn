[node name="KingsTribute" type="Node3D" parent="Interior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -28.9, 2.5, -12)
script = ExtResource("12_readable")
title = "Hommage aux rois"
body = "Nos bons rois et protecteurs du Royaume de Codia ! Codeon I le Fondateur, Codeon II le Hardi, Codeon III le Prudent et Codeon IV le Juste reposent ici. Que leur sagesse veille sur Codeon V et sur tout le royaume."
prompt = "Lire l'hommage"
radius = 2.8

[node name="Slab" type="Node3D" parent="Interior/KingsTribute"]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -0.47, -2.5, 0)
script = ExtResource("17_sign")
text = "Nos bons rois et protecteurs\ndu Royaume de Codia !"
style = 1

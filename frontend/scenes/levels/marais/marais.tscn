[node name="Clues" type="Node3D" parent="."]

[node name="Notebook" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -19.8, 1.2, 25.9)
script = ExtResource("12_readable")
title = "Journal du gardien, an 5803"
body = "La crypte garde l'un des livres anciens. Son tombeau ne s'ouvre que si l'on inscrit, sur le mécanisme des cinq cercles, le nom du royaume transformé selon la règle gravée au mur. Je l'ai noté ici pour ne jamais l'oublier… et j'ai arraché la page le lendemain."
prompt = "Lire le journal"
radius = 2.2

[node name="KeeperTomb" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22.15, 1.6, 1.5)
script = ExtResource("12_readable")
title = "Tombe du gardien"
body = "Ci-gît Aldric, gardien du marais. Né en 5761, mort en 5803. Même la mort ne lui a pas fait quitter son poste."
prompt = "Lire l'épitaphe"
radius = 3

[node name="AdaTomb" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10.5, 1.1, 5.85)
script = ExtResource("12_readable")
title = "Une tombe usée"
body = "Ici repose Ada, qui cachait ses lettres en décalant l'alphabet."
prompt = "Lire l'épitaphe"
radius = 2.2

[node name="Ghost" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 19, 1.6, 3.6)
script = ExtResource("12_readable")
title = "Le fantôme du gardien"
body = "Tu cherches le livre, voyageur ? Il dort dans la crypte, au nord. Le mécanisme réclame le nom de notre royaume, mais jamais tel quel : lis bien ce qui est gravé au mur."
prompt = "Parler au fantôme"
radius = 3.6

[node name="Plaque" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4, 1.25, -34.05)
script = ExtResource("12_readable")
title = "Plaque de la crypte"
body = "Crypte du gardien. Ceux qui descendent doivent savoir dans quel royaume ils se trouvent."
prompt = "Lire la plaque"
radius = 2.8

[node name="Welcome" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.4, 1.3, 53.25)
script = ExtResource("12_readable")
title = "Les marais de Kernel Swamp"
body = "Ici vivaient les pêcheurs de Brumeval. Quand la guerre contre Vibelandia a brisé les digues, l'eau a englouti le village ; seuls ses toits sortent encore de la brume. Au nord, au bout des pontons, la crypte du gardien veille sur les tombeaux des premiers rois de Codia."
prompt = "Lire le panneau"
radius = 2.6

[node name="Notice" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.6, 1.3, 53)
script = ExtResource("12_readable")
title = "Avis de la capitainerie, an 5807"
body = "Par ordre du capitaine du port de Brumeval. Les soldats de Vibelandia ont ouvert les digues du nord, et l'eau monte chaque nuit. Que chaque famille charge ses barques et gagne le château avant la nouvelle lune ; ne prenez que le nécessaire. Personne ne s'abritera dans la crypte des rois : depuis la mort du gardien Aldric, nul ne sait plus l'ouvrir, et l'on dit que son fantôme veille encore au cimetière."
prompt = "Lire l'avis"
radius = 2.8

[node name="AdaSlate" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 11.9, 1.3, 4.4)
script = ExtResource("12_readable")
title = "L'ardoise d'Ada"
body = "Ada apprenait aux enfants de Brumeval à cacher leurs messages. Pour chaque lettre, on avance ou l'on recule dans l'alphabet, et l'on change de sens à chaque lettre. Exemple, avec deux pas : B avance de deux et devient D, R recule de deux et devient P, U avance et devient W, M recule et devient K, E avance et devient G. Ainsi BRUME s'écrit DPWKG. Après Z, on repart de A ; avant A, on revient à Z. Pour relire, il suffit de refaire le chemin à l'envers."
prompt = "Lire l'ardoise"
radius = 2.8

[node name="RoyalOrder" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4.6, 1.3, -32.6)
script = ExtResource("12_readable")
title = "Ordre du roi Codeon V, an 5812"
body = "Codeon V, roi de Codia, à tous ceux qui vivent encore dans les marais. L'armée de Vibelandia marche sur le château. Rejoignez sans attendre le vieux refuge souterrain, près du château : ses portes se fermeront bientôt. Que personne ne force la crypte des rois. Le livre de la logique et du chiffrement y dort sous la garde de nos ancêtres, et seul celui qui sait dans quel royaume il se trouve pourra l'éveiller."
prompt = "Lire l'ordre du roi"
radius = 2.8


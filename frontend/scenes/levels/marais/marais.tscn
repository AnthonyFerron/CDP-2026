[node name="OssuaryRegister" type="Node3D" parent="Interior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -14.98, 1.6, 4)
script = ExtResource("12_readable")
title = "Registre de l'ossuaire"
body = "Ici reposent les bâtisseurs qui ont creusé la crypte sous le règne de Codeon I. Ils ont gravé l'alphabet entier sur cinq cercles de pierre, un cercle par lettre du nom à inscrire : le premier cercle, au centre, porte la première lettre, et le cinquième, au bord, la dernière. Le repère d'or, au nord du mécanisme, montre la lettre choisie sur chaque cercle. Note du gardien : vérifier chaque cercle avant de valider. Une erreur fait gronder la crypte, et le volcan s'éveille plus vite."
prompt = "Lire le registre"
radius = 3.0

[node name="Board" type="Node3D" parent="Interior/OssuaryRegister"]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0.37, -1.6, 0)
script = ExtResource("17_sign")
text = "Registre de l'ossuaire"
style = 2
mount = 1
board_size = Vector2(1.3, 0.7)
board_height = 1.75
line_height = 0.15
serif = true
collision = true

[node name="GuardsOath" type="Node3D" parent="Interior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 14.98, 1.6, 4)
script = ExtResource("12_readable")
title = "Le serment des gardiens"
body = "Moi, gardien du marais, je jure de veiller sur le tombeau des rois et sur le livre des anciens bâtisseurs. Je ne prononcerai jamais le mot du mécanisme et ne l'écrirai jamais en clair. Je le garderai comme on me l'a appris : le nom du royaume, chaque lettre déplacée tour à tour vers l'avant puis vers l'arrière. Ainsi le secret survit aux gardiens."
prompt = "Lire le serment"
radius = 3.0


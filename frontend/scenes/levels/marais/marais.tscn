[node name="Notebook" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -19.6, 1.4, 25.6)
script = ExtResource("12_readable")
title = "Journal du gardien, an 5803"
body = "Les quatre feux du caveau comptent à la manière des anciens. Le feu le plus à droite vaut un ; chaque feu vaut le double de son voisin de droite. Allumés, ils s'additionnent ; éteints, ils ne comptent pas. Le caveau ne s'ouvre qu'au bon nombre."
prompt = "Lire le journal"
radius = 2.2

[node name="KeeperTomb" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22.2, 1.4, 1.5)
script = ExtResource("12_readable")
title = "Tombe du gardien"
body = "Ci-gît Aldric, gardien du Marais. Né en 5761, mort en 5803. Même la mort ne lui a pas fait quitter son poste."
prompt = "Lire l'épitaphe"
radius = 3

[node name="AdaTomb" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10.5, 1.2, 7.4)
script = ExtResource("12_readable")
title = "Une tombe usée"
body = "Ici repose Ada, qui savait tout écrire avec des zéros et des uns."
prompt = "Lire l'épitaphe"
radius = 2

[node name="Ghost" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 19, 1.6, 3.6)
script = ExtResource("12_readable")
title = "Le fantôme du gardien"
body = "Je n'ai jamais quitté ce marais, voyageur. Depuis le jour de ma mort, je compte chaque hiver qui passe sur ma tombe. Nous sommes en l'an 5814, n'est-ce pas ? Alors tu sais depuis combien d'années je veille."
prompt = "Parler au fantôme"
radius = 3.6

[node name="Plaque" type="Node3D" parent="Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.2, 1.4, -34.4)
script = ExtResource("12_readable")
title = "Plaque de la crypte"
body = "Caveau du gardien. Que brûlent les feux qui disent ses années de veille, et le marais rendra ce qu'il garde."
prompt = "Lire la plaque"
radius = 2.8


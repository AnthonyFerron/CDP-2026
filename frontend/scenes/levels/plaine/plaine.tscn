[node name="Fete" type="Node3D" parent="Exterior/Lore"]
transform = Transform3D(0.86603, 0, -0.5, 0, 1, 0, 0.5, 0, 0.86603, 3.15, 1.4, 48.06)
script = ExtResource("12_readable")
title = "L'affiche de la fête des foins"
body = "Grande fête des foins d'Hexcole, an 5804, au premier jour de l'été, dans les prairies devant la bibliothèque. Fauche à l'aube, repas au bord des champs, concours du plus beau mouton et bal des moissonneurs à la nuit tombée. La bibliothécaire lira aux enfants l'histoire de Devlyn, vainqueur des Quatre Dragons du Chaos il y a deux ans. Elle mène la fête comme tous ses chantiers : chaque volontaire inscrit son nom au registre, et chacun saura sa tâche et son heure.

En travers de l'affiche, quelqu'un a écrit au charbon : « Fête annulée. Vibelandia nous a déclaré la guerre. »"
prompt = "Lire l'affiche"
radius = 2.4

[node name="Sign" type="Node3D" parent="Exterior/Lore/Fete"]

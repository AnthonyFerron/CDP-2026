[node name="Greffier" type="Node3D" parent="Interior/Lore"]
transform = Transform3D(-0.96126, 0, -0.27564, 0, 1, 0, 0.27564, 0, -0.96126, 2.48, 0.697, -15.95)
script = ExtResource("12_readable")
title = "Les notes du greffier"
body = "Notes du greffier, réunion sur la restauration des archives.

La bibliothécaire et son employé ont parlé chacun son tour : elle propose, il répond, et chaque réplique reprend le fil de la précédente. Six répliques en tout, que j'ai recopiées dans l'ordre sur une seule feuille.

Ce soir, la bibliothécaire m'a repris la feuille. Elle l'a découpée aux ciseaux, une réplique par morceau, et m'a fait promettre de ne jamais en dire l'ordre. Je tiens ma promesse."
prompt = "Lire les notes"
radius = 2.2


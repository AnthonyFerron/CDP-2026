transform = Transform3D(0.76604, 0, 0.64279, 0, 1, 0, -0.64279, 0, 0.76604, -7.28, 1, 17.07)
script = ExtResource("12_readable")
title = "La stèle de la bibliothèque"
body = "Bibliothèque d'Hexcole. Fondée au temps des anciens bâtisseurs pour garder le savoir de Codia, au milieu des prairies qui couvraient alors les plaines. Sous la date, une devise : « Un projet bien mené commence par un but, et s'achève par un bilan. »"
prompt = "Lire la stèle"
radius = 2.6


[node name="Reglement" type="Node3D" parent="Interior/Lore"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.95, 1.65, -11.45)
script = ExtResource("12_readable")
title = "Le règlement de la bibliothèque"
body = "Règlement de la bibliothèque d'Hexcole, sous l'autorité de la bibliothécaire.

I. On parle bas : les livres dorment.
II. Tout livre emprunté s'inscrit au registre, avec le nom du lecteur et la date.
III. Un livre sorti de son rang porte un signet, pour qu'on sache où le remettre.
IV. Chaque chantier se mène pas à pas : on ne passe à l'étape suivante qu'une fois la précédente achevée.
V. Pas de bougie entre les rayonnages, pas de feu près des archives."
prompt = "Lire le règlement"
radius = 2.2


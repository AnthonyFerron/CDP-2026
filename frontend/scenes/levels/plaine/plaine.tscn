[node name="Graves" type="Node3D" parent="Exterior/Lore"]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 16.98, 1, 50.5)
script = ExtResource("12_readable")
title = "La stèle des défenseurs"
body = "Aux gardes de la bibliothèque d'Hexcole, tombés pour que les livres de Codia ne brûlent pas. Ils ont tenu la barricade trois jours contre les troupes de Vibelandia, jusqu'à ce que leurs catapultes mettent le feu au toit. Leurs noms sont gravés au dos de la pierre : Aldric, Brune, Corentin, Doria, Edmond et Faye."
prompt = "Lire la stèle"
radius = 2.6


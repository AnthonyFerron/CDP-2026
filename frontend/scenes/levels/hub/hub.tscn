script = ExtResource("10_readable")
title = "Le jardin du roi"
body = "Allées de gravier, parterres et kiosque à musique : les habitants s'y promenaient le soir, au bord de la rivière. Au centre, la statue de Devlyn rappelle la victoire de l'an 5802 sur les Quatre Dragons du Chaos."
prompt = "Lire : Le jardin du roi"

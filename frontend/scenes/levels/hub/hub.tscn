script = ExtResource("10_readable")
title = "L'observatoire du Mont Sam Altan"
body = "Du haut de cette tour, les veilleurs du roi guettaient le volcan, endormi depuis des siècles. Leur registre s'arrête en 5812, la veille du départ pour le bunker : « Fumée légère au sommet. Rien à signaler. »"

[node name="Bran" type="Node3D" parent="Characters"]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 85, -40, -0.8)
script = ExtResource("10_readable")
title = "Bran, le forgeron"
body = "Pendant huit ans, j'ai forgé les épées de tes soldats, Devlyn. Ma forge est restée là-haut, au bord de la rivière. Les portails que Merlon a ouverts mènent à des terres perdues : fais attention, ce qui reste là-bas n'a rien d'accueillant."
prompt = "Parler à Bran"
radius = 3.0
metadata/pose = "idle"


transform = Transform3D(-1, 0, 0, 0, 1, 0, -0, 0, -1, -21, 0, 60.4)
script = ExtResource("10_readable")
title = "La halle du marché"
body = "Les jours de marché, les paysans des plaines d'Hexcole et les marchands venus du désert de Pythania s'y retrouvaient à l'abri. Son toit s'est effondré pendant les combats ; les étals sont restés dessous."
prompt = "Lire : La halle du marché"

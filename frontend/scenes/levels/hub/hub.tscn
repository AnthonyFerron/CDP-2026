script = ExtResource("10_readable")
title = "L'allée des rois"
body = "Codeon I, le bâtisseur ; Codeon II, le sage ; Codeon III, le jardinier ; Codeon IV, le prudent. Les statues des anciens rois bordent l'allée qui mène à celle de Devlyn. Renversées pendant la guerre, elles attendent qu'on les relève."
prompt = "Lire : L'allée des rois"

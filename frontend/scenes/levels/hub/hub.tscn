[node name="OrchardSign" type="Node3D" parent="Lore"]
transform = Transform3D(-0.98481, 0, -0.17365, 0, 1, 0, 0.17365, 0, -0.98481, 9.6, 0, 71.6)
script = ExtResource("10_readable")
title = "Le verger du roi"
body = "Pommiers et poiriers en rangs serrés : le roi Codeon III les avait plantés pour les enfants du village, qui venaient y cueillir les fruits à l'automne. La guerre n'a laissé que des souches."
prompt = "Lire : Le verger du roi"

[node name="Elda" type="Node3D" parent="Characters"]
transform = Transform3D(0.34202, 0, 0.93969, 0, 1, 0, -0.93969, 0, 0.34202, 75, -40, 3.2)
script = ExtResource("10_readable")
title = "Elda, la tisserande"
body = "Quand le roi a fait sonner les cloches, nous avons couru jusqu'ici avec ce que nous pouvions porter. Tant d'autres ne sont jamais arrivés… Si tu rapportes ces livres, nous pourrons enfin remonter vivre au soleil."

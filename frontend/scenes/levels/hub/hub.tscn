[node name="Mira" type="Node3D" parent="Characters"]
transform = Transform3D(0.34202, 0, 0.93969, 0, 1, 0, -0.93969, 0, 0.34202, 70.6, -40, -1.6)
script = ExtResource("10_readable")
title = "Mira, l'éclaireuse"
body = "Deux ans que nous vivons sous terre, au bruit des combats lointains. Puis le silence… La guerre contre Vibelandia est finie, mais personne n'ose remonter. On raconte que les livres des anciens bâtisseurs gardent la mémoire du monde d'avant. S'ils reviennent, peut-être que la terre se souviendra."
prompt = "Parler à Mira"
radius = 3.0
metadata/pose = "idle"

[node name="Model" parent="Characters/Mira" instance=ExtResource("13_archer")]

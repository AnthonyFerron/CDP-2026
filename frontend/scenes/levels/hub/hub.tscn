transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 47.74, 0, 36)
script = ExtResource("10_readable")
title = "La boulangerie"
body = "Chaque matin, l'odeur du pain chaud montait jusqu'au château. La farine venait du moulin voisin, le blé de la ferme du roi. Pendant la guerre, le boulanger cuisait encore pour les soldats, jusqu'à la dernière poignée de farine."

transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.4, 0, -85.2)
script = ExtResource("10_readable")
title = "Codeon V, roi de Codia"
body = "Mon royaume n'est plus que ruines, Devlyn, et voilà que le volcan menace d'emporter ce qu'il en reste. Tu as déjà sauvé ces terres des Quatre Dragons du Chaos. Je n'ai pas le droit de te le demander une seconde fois… et pourtant, je le fais."
prompt = "Parler au roi"
radius = 3.0


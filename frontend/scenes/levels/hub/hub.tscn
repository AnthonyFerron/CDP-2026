script = ExtResource("10_readable")
title = "L'école de Codia"
body = "Avant la guerre, on y apprenait aux enfants l'art des instructions : découper un problème, mettre les étapes dans l'ordre, vérifier chaque résultat. Sur le tableau, quelqu'un a écrit à la craie : « Les anciens bâtisseurs ont tout consigné dans quatre livres. »"

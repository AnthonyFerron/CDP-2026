[node name="Clues" type="Node3D" parent="Interior"]

[node name="Caravan" type="Node3D" parent="Exterior/Clues"]
transform = Transform3D(0.34202, 0, 0.939693, 0, 1, 0, -0.939693, 0, 0.34202, -32.85, 0.9, -30.29)
script = ExtResource("12_readable")
title = "Le carnet du caravanier"
body = "Carnet d'un caravanier. Nous menions nos épices et nos étoffes vers Codia quand Vibelandia a déclaré la guerre : les routes du nord sont tombées, il ne restait que la piste du désert de Pythania. Trois jours que la tempête nous tient, et le vent brûle comme une forge. Le vieux guide dit que les anciens bâtisseurs gravaient leurs instructions sur des runes, et qu'il suffit de les remettre dans l'ordre pour que le sable rende ce qu'il garde. Nous en avons vu briller dans les salles du monument, parmi les débris, et sous des tas de sable. Certains tas ne cachent rien : il faut creuser quand même. L'eau manque. Les vautours tournent au-dessus des bêtes."
prompt = "Lire le carnet"
radius = 2.4

[node name="Cover" type="MeshInstance3D" parent="Exterior/Clues/Caravan"]

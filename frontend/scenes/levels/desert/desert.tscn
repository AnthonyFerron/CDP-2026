[node name="ArchivistScroll" type="Node3D" parent="Interior/Clues"]
transform = Transform3D(1, 0, 0, 0, 1, 0, -0, 0, 1, 3.75, 0.64, -2.65)
script = ExtResource("12_readable")
title = "Le rouleau de l'archiviste"
body = "Rouleau resté ouvert sur le pupitre. « Avant d'ouvrir la porte du temple, le gardien pose une question au voyageur. Si la réponse est la bonne, il agit d'une façon ; sinon, il agit d'une autre, et la cité entière l'entend. Une condition commence par sa question et s'achève quand ses deux chemins se rejoignent. » En marge, d'une autre main : « Les runes rangées ici ont été mêlées à celles du dehors. Remettez-les dans l'ordre des murs. »"
prompt = "Lire le rouleau"
radius = 2


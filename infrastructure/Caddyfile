{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	# Page « nouveau mot de passe » (infrastructure/web/reinitialisation), ouverte depuis le lien de l'e-mail :
	# /reinitialisation?token=<jeton>. Le jeton ne doit sortir de la page vers aucun autre site (no-referrer),
	# ni rester en cache. Ce site n'a pas de directive `log` : aucun journal d'accès n'enregistre l'adresse.
	# Si on en ajoute un, retirer le jeton de l'adresse journalisée :
	#   log { format filter { request>uri query { delete token } } }
	@reinitialisation path /reinitialisation /reinitialisation/*
	handle @reinitialisation {
		header {
			Referrer-Policy no-referrer
			Cache-Control no-store
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
		}
		root * /srv
		rewrite /reinitialisation /reinitialisation/index.html
		file_server
	}

	# Le jeu. Ses fichiers gardent le même nom d'une version à l'autre : le navigateur garde sa copie mais vérifie
	# à chaque visite (ETag) qu'elle est encore à jour. Ils sont compressés au build (frontend/Dockerfile) ;
	# `encode` ne compresse plus que le reste.
	# L'export web utilise des fils d'exécution (le son est mixé hors du fil principal) : il lui faut
	# SharedArrayBuffer, donc une page isolée (COOP et COEP). Tout ce que charge le jeu vient de ce même site,
	# `require-corp` ne bloque donc rien. Voir docs/web-threads.md.
	# Le second paquet, musique.pck, que le jeu télécharge une fois le menu affiché, passe par ici comme index.pck :
	# mêmes en-têtes, même revalidation, même .br et .gz précompressés (docs/musique-differee.md).
	handle {
		root * /srv
		header {
			Cache-Control no-cache
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
		}
		file_server {
			precompressed br gzip
		}
	}
}

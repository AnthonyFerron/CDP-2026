POSTGRES_PASSWORD=CHANGE_ME
# :80 sans domaine, ou le nom de domaine pour activer le HTTPS automatique
SITE_ADDRESS=:80

# Clé HMAC des codes de connexion : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Envoi des codes de connexion. Sans SMTP_HOST, la connexion répond 503 : aucun code n'est
# jamais écrit dans les logs en production, sauf si EMAIL_BACKEND=console est choisi explicitement.
EMAIL_BACKEND=smtp
EMAIL_FROM=CodeQuest <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

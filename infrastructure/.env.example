POSTGRES_PASSWORD=CHANGE_ME
# :80 sans domaine, ou le nom de domaine pour activer le HTTPS automatique
SITE_ADDRESS=:80

# Clé HMAC des codes de connexion, dont est dérivée la clé des liens de réinitialisation du mot de passe :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Envoi des codes de connexion et des liens de réinitialisation. Sans SMTP_HOST, la connexion répond 503 :
# aucun code n'est jamais écrit dans les logs en production, sauf si EMAIL_BACKEND=console est choisi
# explicitement.
EMAIL_BACKEND=smtp
EMAIL_FROM=CodeQuest <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Adresse de la page de réinitialisation du mot de passe, dans le lien envoyé par e-mail (?token=… ajouté)
PASSWORD_RESET_URL=https://codequest.anthonyferron.com/reinitialisation

# Copier ce fichier en backend/.env pour le développement local. Ne jamais versionner le .env.

# --- Base de données ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/escape_game
# Base dédiée aux tests : son nom doit contenir « test », elle est vidée à chaque lancement.
# Exemple avec infrastructure/docker-compose.yml, après :
#   docker compose -f infrastructure/docker-compose.yml exec db createdb -U escape_user escape_game_test
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/escape_game_test

# --- Sécurité ---
# Clé HMAC des codes 2FA. À générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# Vide : une clé temporaire est tirée à chaque démarrage (les codes en attente sont alors perdus).
SECRET_KEY=

# --- E-mails ---
# console : le code s'affiche dans les logs de l'API (développement uniquement)
# smtp    : envoi réel, avec les paramètres SMTP ci-dessous (production)
EMAIL_BACKEND=console
EMAIL_FROM=CodeQuest <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) ou none
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10

# --- CORS ---
# Origines autorisées, séparées par des virgules. Vide en production (même domaine que le jeu).
# Exemple pour lancer le jeu depuis l'éditeur Godot : http://localhost:8060
CORS_ALLOWED_ORIGINS=

# --- Règles du jeu (valeurs par défaut) ---
GAME_DURATION_SECONDS=3600
PENALTY_SECONDS=300
# Résolution plus rapide : acceptée, mais la partie sort du classement
PUZZLE_MIN_SOLVE_SECONDS=30

# --- Authentification (valeurs par défaut) ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
SESSION_TTL_HOURS=168
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
